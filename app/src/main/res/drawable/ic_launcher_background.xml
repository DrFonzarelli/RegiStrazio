<?xml version="1.0" encoding="utf-8"?>
<!--
    Livello di sfondo dell'icona adattiva: solo il colore crema, steso su
    tutto il viewport.

    Nell'SVG di partenza il crema ha una sagoma tondeggiante propria, qui no —
    ed è voluto. Il launcher ritaglia l'icona con la *sua* maschera (cerchio,
    squircle, goccia...), quindi la forma del bordo non la decidiamo noi: se
    tenessimo la sagoma dell'SVG, dove i suoi angoli sono più arrotondati della
    maschera si vedrebbero quattro spicchi trasparenti. Il fondo pieno copre
    qualunque maschera, e il bordo tondo lo mette il sistema.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="192"
    android:viewportHeight="192">
    <path
        android:fillColor="#F1E9E0"
        android:pathData="M0,0 L192,0 L192,192 L0,192 Z" />
</vector>
